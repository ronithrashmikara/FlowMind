# One of these is required. Keys stay on the server; never put them in NEXT_PUBLIC_* variables.
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Optional: pick a provider when both keys are set (openrouter | mistral)
LLM_PROVIDER=

# Optional model overrides
OPENROUTER_MODEL=stealth/space-bunny-alpha
OPENROUTER_EMBED_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_REASONING=low
MISTRAL_MODEL=mistral-small-latest
